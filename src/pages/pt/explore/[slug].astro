---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import places from '../../../data/explore.json';

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

const { place } = Astro.props;
const title = `${place.name} | Guia de visita`;
const image = `/explore/${place.slug}.webp`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const map = 'https://www.google.com/maps/search/?api=1&query='
  + encodeURIComponent(`${place.name}, ${place.address}`);
const rating = place.rating
  ? `${place.rating.value.toLocaleString('pt-BR')}/5 · ${place.rating.count.toLocaleString('pt-BR')} avaliações`
  : undefined;
const category = { natureza: 'Natureza e passeios ao ar livre', cultura: 'Cultura e patrimônio', lazer: 'Parques e atrações' };
const related = places.filter((item) => item.category === place.category && item.slug !== place.slug).slice(0, 3);
const date = place.listed?.split('-').reverse().join('/');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Cataratas Brasil', item: new URL('/pt/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: place.name, item: url },
  ],
};
---
<BaseLayout lang="pt" title={title} description={place.background} image={image} availableLangs={['pt']}>
  <Nav lang="pt" />
  <main>
    <header class="relative min-h-[68vh] flex items-end pt-24 bg-[color:var(--color-ink)] text-white overflow-hidden">
      <img class="absolute inset-0 w-full h-full object-cover" src={image} alt={place.name} fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
      <div class="relative max-w-7xl mx-auto px-6 pb-12 w-full">
        <a class="link-underline" href="/pt/#explore">Conheça Foz do Iguaçu e arredores</a>
        <h1 class="font-display text-4xl md:text-6xl max-w-4xl mt-4">{place.name}</h1>
        <p class="mt-4 max-w-2xl text-lg">{place.tagline}</p>
        {(rating || place.hours) && (
          <ul class="mt-4 flex max-w-2xl flex-wrap gap-x-5 gap-y-2 text-sm text-white/90">
            {rating && <li><a class="link-underline" href="#avaliacoes">{rating}</a></li>}
            {place.hours && <li><a class="link-underline" href="#horarios">{place.hours}</a></li>}
          </ul>
        )}
        <a class="inline-block mt-6 rounded-full bg-[color:var(--color-sun)] text-[color:var(--color-ink)] font-bold px-5 py-3" href={map}>Ver no Google Maps ↗</a>
      </div>
    </header>
    <div class="max-w-4xl mx-auto px-6 py-14 space-y-10 text-[color:var(--color-moss)]">
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Conheça {place.name}</h2>
        <p>{place.tagline}.</p>
        <h3 class="font-display text-xl">Dicas para a visita</h3>
        <p>{place.tip}</p>
        <h3 class="font-display text-xl">Destaques do local</h3>
        <p>{place.observe}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Sobre {place.name}</h2>
        <p><strong>Gestão e operação</strong> · {place.operator}.</p>
        <a class="link-underline" href={place.official}>Canal oficial ↗</a>
      </section>
      <section id="informacoes" class="space-y-4 scroll-mt-20">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Informações para a visita</h2>
        <dl class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-4">
          <div><dt class="font-bold">Endereço de referência</dt><dd>{place.address}</dd></div>
          <div><dt class="font-bold">Cidade</dt><dd>{place.city}</dd></div>
          <div><dt class="font-bold">Tipo de visita</dt><dd>{category[place.category as keyof typeof category]}</dd></div>
          <div><dt class="font-bold">Responsável</dt><dd>{place.operator}</dd></div>
          {place.duration && <div><dt class="font-bold">Duração indicada</dt><dd>{place.duration}</dd></div>}
          {place.parking && <div><dt class="font-bold">Estacionamento informado</dt><dd>{place.parking}</dd></div>}
          {rating && <div><dt class="font-bold">Avaliação no Google Maps</dt><dd><a href="#avaliacoes" class="link-underline">{rating}</a></dd></div>}
        </dl>
        <p class="text-sm">
          {date && <>Ficha municipal de {date}. </>}
          <a class="link-underline" href={place.official}>Consulte horários, ingressos e acesso antes da visita ↗</a>
        </p>
      </section>
      <section class="space-y-3">
        <h2 id="horarios" class="font-display text-3xl text-[color:var(--color-ink)]">Horários de visita</h2>
        {place.hours && <p>{place.hours}</p>}
        <a class="link-underline" href={place.official}>Consultar horários e condições de acesso ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Ingressos e preços</h2>
        {place.ticket && <p>{place.ticket}{date && ` · Ficha municipal de ${date}`}</p>}
        <a class="link-underline" href={place.official}>Consultar valores e condições de entrada ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Como chegar</h2>
        <p>{place.arrival}</p>
        <a class="link-underline" href={map}>Traçar rota para {place.name} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">História, características e experiência de visita</h2>
        <p>{place.background}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Roteiro de visita</h2>
        <p>{place.walk}</p>
        <ol class="list-decimal space-y-2 pl-6">
          {place.steps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Cuidados durante a visita</h2>
        <p>{place.notice}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Onde fotografar</h2>
        <p>{place.photo}</p>
        <p><a class="link-underline text-sm" href={place.photoSource}>Fonte da imagem ↗</a></p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Perguntas frequentes</h2>
        {[[place.question, place.answer], [place.extraQuestion, place.extraAnswer]].map(([question, answer]) => (
          <details class="rounded-2xl border border-black/10 p-6">
            <summary class="cursor-pointer font-bold">{question}</summary>
            <p class="mt-3">{answer}</p>
          </details>
        ))}
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Onde se hospedar</h2>
        <p>{place.stay}</p>
      </section>
      <section id="avaliacoes" class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-3 scroll-mt-20">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">Avaliações de visitantes</h2>
        {rating && <p>
          <strong>{rating}</strong>
          {' '}· Google Maps, conforme a ficha municipal de {date}.
        </p>}
        <a class="link-underline" href={place.mapListing || map}>Consultar avaliações no Google Maps ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">Endereço e mapa</h2>
        <p>{place.address}</p>
        <a class="link-underline" href={map}>Abrir localização no Google Maps ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">Mais lugares para visitar</h2>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {related.map((item) => <li><a class="link-underline" href={`/pt/explore/${item.slug}/`}>{item.name} →</a></li>)}
        </ul>
        <a class="link-underline text-sm" href={place.source}>Secretaria Municipal de Turismo de Foz do Iguaçu ↗</a>
      </section>
    </div>
  </main>
  <Footer lang="pt" showAttraction={false} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
