---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PracticalInfo from '../../components/PracticalInfo.astro';
import Highlights from '../../components/Highlights.astro';
import Transport from '../../components/Transport.astro';
import Faq from '../../components/Faq.astro';

const title = 'Trilha das Cataratas — Cataratas do Iguaçu | Guia 2026';
const desc = 'A Trilha das Cataratas no Parque Nacional do Iguaçu tem 1,5 km de passarela até o Mirante da Garganta do Diabo. Veja horários, ingressos, acessibilidade e como chegar a partir de Foz do Iguaçu.';
const canonical = 'https://cataratasbrasil.com/pt/trilha-das-cataratas/';

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Cataratas Brasil', item: 'https://cataratasbrasil.com/pt/' },
    { '@type': 'ListItem', position: 2, name: 'Trilha das Cataratas', item: canonical },
  ],
});
const webPage = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Trilha das Cataratas',
  url: canonical,
  inLanguage: 'pt-BR',
});
---
<BaseLayout lang="pt" title={title} description={desc} availableLangs={['pt']}>
  <Nav lang="pt" />
  <header class="hero">
    <div class="hero-bg" style="background-image: url('/gallery/trilha-das-cataratas-brasil (6).jpg');"></div>
    <div class="hero-content">
      <div class="hero-content-inner">
        <p class="section-num">Trilha das Cataratas</p>
        <h1>Trilha das Cataratas<br/><span class="italic text-[color:var(--color-sun)]">até a Garganta do Diabo</span></h1>
        <p class="hero-subtitle">A <strong>Trilha das Cataratas</strong> é a passarela de <strong>1,5 km</strong> dentro do <strong>Parque Nacional do Iguaçu</strong>, em <strong>Foz do Iguaçu</strong>, que leva você do Centro de Visitantes até o <strong>Mirante da Garganta do Diabo</strong> — o coração das <strong>Cataratas do Iguaçu</strong>. Pavimentada, acessível e rodeada pela Mata Atlântica, é o caminho obrigatório para ver o maior sistema de quedas do planeta de cima.</p>
        <div class="hero-stats">
          <div><div class="num-display text-4xl md:text-5xl">1.5<span class="text-lg">km</span></div><div class="text-xs uppercase tracking-widest text-white/70">Extensão</div></div>
          <div><div class="num-display text-4xl md:text-5xl">3–4<span class="text-lg">h</span></div><div class="text-xs uppercase tracking-widest text-white/70">Duração</div></div>
          <div><div class="num-display text-4xl md:text-5xl">100%</div><div class="text-xs uppercase tracking-widest text-white/70">Acessível</div></div>
        </div>
      </div>
    </div>
  </header>

  <PracticalInfo lang="pt" />
  <Highlights lang="pt" />
  <Transport lang="pt" />
  <Faq lang="pt" />

  <section class="section bg-[color:var(--color-cream)]">
    <div class="container text-center">
      <p class="section-num">Continue explorando</p>
      <h2 class="section-title">Volte ao guia completo</h2>
      <p class="section-lead">Quer saber sobre o Mirante da Garganta do Diabo, horários de pico e dicas de foto? Veja a página principal.</p>
      <a class="bg-[color:var(--color-sun)] text-[color:var(--color-ink)] font-mulish font-bold px-6 py-3 rounded-full inline-block" href="/pt/">Guia completo do Mirante →</a>
    </div>
  </section>

  <Footer lang="pt" />

  <Fragment set:html={'<script type="application/ld+json">' + breadcrumb + '</script><script type="application/ld+json">' + webPage + '</script>'} />
</BaseLayout>

<style>
  .hero { position: relative; min-height: 78vh; display: flex; align-items: flex-end; }
  .hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,46,38,0.35) 0%, rgba(15,46,38,0.85) 100%); }
  .hero-content { position: relative; width: 100%; padding-bottom: 3rem; }
  .hero-content-inner { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; color: #fff; }
  .hero-subtitle { max-width: 46rem; margin-top: 1rem; font-size: 1.05rem; line-height: 1.7; color: rgba(255,255,255,0.92); }
  .hero-stats { display: flex; gap: 2.5rem; margin-top: 2rem; flex-wrap: wrap; }
  @media (max-width: 640px) { .hero-subtitle { font-size: 0.95rem; } .hero-stats { gap: 1.5rem; } }
</style>
