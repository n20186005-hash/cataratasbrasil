---
import '../../../src/styles/global.css';
import { LANGUAGES, type Lang } from '../../i18n/utils';
import { trailSlug, viewpointSlug, visitGuides } from '../../i18n/visit-guides';
import { t, meta } from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import Manifesto from '../../components/Manifesto.astro';
import Highlights from '../../components/Highlights.astro';
import PracticalInfo from '../../components/PracticalInfo.astro';
import Transport from '../../components/Transport.astro';
import Encyclopedia from '../../components/Encyclopedia.astro';
import Ecology from '../../components/Ecology.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import ExploreDirectory from '../../components/ExploreDirectory.astro';
import Surrounding from '../../components/Surrounding.astro';
import Faq from '../../components/Faq.astro';
import LeaveNoTrace from '../../components/LeaveNoTrace.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const _ = (value: Parameters<typeof t>[0]) => t(value, lang);
const title = _(meta.title);
const desc = _(meta.description);
const guides = visitGuides[lang];
---
<BaseLayout lang={lang} title={title} description={desc}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Manifesto lang={lang} />
  <Highlights lang={lang} />
  <PracticalInfo lang={lang} />
  <Transport lang={lang} />
  <section id="visit-guides" class="bg-[color:var(--color-cream)] py-16 scroll-mt-16">
    <div class="container mx-auto max-w-5xl px-6">
      <h2 class="section-title text-center">{guides.heading}</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {[[trailSlug, guides.trail, guides.trailIntro], [viewpointSlug, guides.viewpoint, guides.viewpointIntro]].map(([slug, heading, intro]) => (
          <article class="rounded-3xl bg-white border border-black/5 p-6">
            <h3 class="font-display text-2xl"><a class="link-underline" href={`/${lang}/${slug}/`}>{heading} →</a></h3>
            <p class="mt-3 text-[color:var(--color-moss)]">{intro}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Encyclopedia lang={lang} />
  <Ecology lang={lang} />
  <Gallery lang={lang} />
  <Reviews lang={lang} />
  <Surrounding lang={lang} />
  <ExploreDirectory lang={lang} />
  <LeaveNoTrace lang={lang} />
  <Faq lang={lang} />
  <Footer lang={lang} />
  <StructuredData lang={lang} />
</BaseLayout>
