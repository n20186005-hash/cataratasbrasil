---
import { ui, placeName } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Highlights from '../../components/Highlights.astro';
import PracticalInfo from '../../components/PracticalInfo.astro';
import Transport from '../../components/Transport.astro';
import Faq from '../../components/Faq.astro';
import { nearby, nearbyCopy, nearbySlugs, visitLabels } from '../../i18n/nearby';
import { detailLabels, guideDetails } from '../../i18n/guide-details';
import { LANGUAGES, type Lang } from '../../i18n/utils';
import {
  guideSlugs, trailSlug, viewpointSlug, trailMap, viewpointMap, visitGuides, visitSources,
} from '../../i18n/visit-guides';

export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) => guideSlugs.map((guide) => ({ params: { lang, guide }, props: { guide } })));
}

const lang = Astro.params.lang as Lang;
const { guide } = Astro.props;
const [historyLabel, routeLabel, photoLabel, faqLabel] = detailLabels[lang];
const [background, observation, route, photoTip, question, answer] = guideDetails[guide][lang];
const nearbySlug = nearbySlugs.find((slug) => slug === guide);
const place = nearbySlug && nearby[nearbySlug];
const placeCopy = nearbySlug && nearbyCopy[nearbySlug][lang];
const [management, basics, entrance, hours, tickets, reviews, reviewLink, transit, nearbyTitle, previousRating] = visitLabels[lang];
const days = {
  pt: ['Seg–sex', 'Sáb–dom'], en: ['Mon–Fri', 'Sat–Sun'], es: ['Lun–vie', 'Sáb–dom'],
  zh: ['周一至周五', '周六及周日'], ko: ['월–금', '토–일'],
}[lang];
const parkHours = `${days[0]} 09:00–16:00 · ${days[1]} 08:30–16:00`;
const openingHours = nearbySlug === 'macuco-safari'
  ? `${days[0]} 09:00–17:00 · ${days[1]} 08:30–17:00`
  : place ? place.hours : parkHours;
const isTrail = guide === trailSlug;
const copy = visitGuides[lang];
const title = place ? `${placeName(nearbySlug!, lang)} · ${ui('city', lang)}` : isTrail ? copy.trail : copy.viewpoint;
const description = placeCopy ? placeCopy[0] : isTrail ? copy.trailIntro : copy.viewpointIntro;
const related = isTrail ? viewpointSlug : trailSlug;
const maps = place ? place.map : isTrail ? trailMap
  : 'https://www.google.com/maps/search/?api=1&query=Mirante+da+Garganta+do+Diabo+Porto+Canoas+Foz+do+Igua%C3%A7u';
const reviewMaps = place || isTrail ? maps : viewpointMap;
const additionalPhoto = isTrail ? '/gallery/trilha-das-cataratas-brasil (1).jpg'
  : place ? undefined : '/gallery/trilha-das-cataratas-brasil (8).jpg';
const historySource = nearbySlug ? ({
  'parque-das-aves': 'https://www.parquedasaves.com.br/blog/foz-do-iguacu-parque-das-aves-8-momentos-historicos/',
  'itaipu-panoramica': 'https://www.itaipu.gov.br/visitas',
  'macuco-safari': 'https://www.gov.br/turismo/pt-br/acesso-a-informacao/acoes-e-programas/programas-projetos-acoes-obras-e-atividades/rede-inteligencia-mercado/BIMT7TurismoNautico_compressed.pdf',
} as Partial<Record<typeof nearbySlugs[number], string>>)[nearbySlug]
  : 'https://www.gov.br/icmbio/pt-br/assuntos/unidade-de-conservacao/unidades-de-biomas/mata-atlantica/lista-de-ucs/parna-do-iguacu/pagina/historia';
const home = new URL(`/${lang}/`, Astro.site).href;
const url = new URL(`/${lang}/${guide}/`, Astro.site).href;
const image = place ? `/nearby/${nearbySlug}.webp` : '/gallery/trilha-das-cataratas-brasil (6).jpg';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', name: title, url, description, inLanguage: lang,
      primaryImageOfPage: new URL(image, Astro.site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: copy.home, item: home },
        { '@type': 'ListItem', position: 2, name: title, item: url },
      ],
    },
  ],
};
---
<BaseLayout lang={lang} title={title} description={description} image={image}>
  <Nav lang={lang} languageSuffix={`${guide}/`} />
  <main>
    <header class="relative min-h-[68vh] flex items-end pt-24 bg-[color:var(--color-ink)] text-white">
      <img src={image} alt={title} fetchpriority="high" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
      <div class="relative max-w-7xl mx-auto px-6 pb-12 w-full">
        <a class="link-underline" href={home}>{copy.home}</a>
        <h1 class="font-display text-4xl md:text-6xl max-w-4xl mt-4">{title}</h1>
        <p class="mt-4 max-w-2xl text-lg">{description}</p>
        <a class="inline-block mt-6 rounded-full bg-[color:var(--color-sun)] text-[color:var(--color-ink)] font-bold px-5 py-3" href={maps}>{copy.map} ↗</a>
      </div>
    </header>
    <section class="max-w-4xl mx-auto px-6 py-14 space-y-6 text-[color:var(--color-moss)]">
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{management}</h2>
      <p>{placeCopy ? placeCopy[1] : copy.about}</p>
      <p>{background}</p>
      {place && placeCopy ? <>
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{basics}</h2>
        <dl class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-4">
          <div><dt class="font-bold">{entrance}</dt><dd>{place.address}</dd></div>
          <div><dt class="font-bold">{hours}</dt><dd>{openingHours || <a class="link-underline" href={place.official}>{copy.sources} ↗</a>}</dd></div>
          <div><dt class="font-bold">{tickets}</dt><dd>{placeCopy[2]}</dd></div>
        </dl>
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{transit}</h2>
        <p>{placeCopy[3]}</p>
        <p><a class="link-underline" href={place.official}>{copy.sources} ↗</a></p>
        <p class="text-sm"><a class="link-underline" href={place.photo}>{place.credit} ↗</a></p>
      </> : <>
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{ui('park', lang)}</h2>
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{basics}</h2>
      <dl class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-4">
        <div><dt class="font-bold">{entrance}</dt><dd>{ui('visitors', lang)} · BR-469, km 18 · {ui('city', lang)}, PR</dd></div>
        <div><dt class="font-bold">{hours}</dt><dd>{openingHours}. {copy.timing}</dd></div>
        <div><dt class="font-bold">{tickets}</dt><dd>{copy.ticket}</dd></div>
      </dl>
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{copy.access}</h2>
      {isTrail ? (
        <ol class="list-decimal space-y-3 pl-6">
          {[copy.start, copy.walk, copy.finish].map((step) => <li>{step}</li>)}
        </ol>
      ) : (
        <div class="space-y-3">
          <p>{copy.start}</p>
          <p>{copy.alternative}</p>
          <p>{copy.finish}</p>
          <p>{copy.photo}</p>
        </div>
      )}
      {isTrail && <p>{copy.alternative}</p>}
      <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{copy.sources}</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li><a class="link-underline" href={visitSources.visit}>Cataratas do Iguaçu · {copy.sources}</a></li>
        <li><a class="link-underline" href={visitSources.access}>Porto Canoas · {copy.access}</a></li>
        <li><a class="link-underline" href={visitSources.authority}>ICMBio · {ui('park', lang)}</a></li>
      </ul>
      <a class="link-underline font-bold" href={`/${lang}/${related}/`}>{isTrail ? copy.viewpoint : copy.trail} →</a>
      </>}
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{historyLabel}</h2>
      <p>{observation}</p>
      {historySource && <a class="link-underline text-sm" href={historySource}>{copy.sources} ↗</a>}
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{routeLabel}</h2>
      <p>{route}</p>
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{photoLabel}</h2>
      <p>{photoTip}</p>
      {additionalPhoto && <img class="w-full max-h-[32rem] object-contain rounded-2xl" src={additionalPhoto} alt={title} loading="lazy" />}
      <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{faqLabel}</h2>
      <details class="rounded-2xl bg-[color:var(--color-mist)] p-6">
        <summary class="cursor-pointer font-bold">{question}</summary>
        <p class="mt-3">{answer}</p>
      </details>
      <aside class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-3">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{reviews}</h2>
        {!place && !isTrail && <p><strong>4.9/5 · {new Intl.NumberFormat(lang).format(19611)}</strong> · {previousRating}</p>}
        <a class="link-underline" href={reviewMaps}>{reviewLink} ↗</a>
      </aside>
      <div class="rounded-2xl border border-black/10 p-6">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{entrance}</h2>
        <p class="mt-2">{place?.address ?? `${ui('visitors', lang)} · BR-469, km 18 · ${ui('city', lang)}, PR`}</p>
        <a class="inline-block mt-2 link-underline" href={maps}>{copy.map} ↗</a>
      </div>
      <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{nearbyTitle}</h2>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {nearbySlugs.filter((slug) => slug !== nearbySlug).map((slug) => (
          <li><a class="link-underline" href={`/${lang}/${slug}/`}>{placeName(slug, lang)} →</a></li>
        ))}
        {place && <li><a class="link-underline" href={`/${lang}/${viewpointSlug}/`}>{copy.viewpoint} →</a></li>}
      </ul>
    </section>
    {isTrail && lang === 'pt' && <><PracticalInfo lang={lang} /><Highlights lang={lang} /><Transport lang={lang} /><Faq lang={lang} /></>}
  </main>
  <Footer lang={lang} showAttraction={!place} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
