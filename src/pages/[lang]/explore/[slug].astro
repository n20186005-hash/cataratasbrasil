---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { explorePlaces, localizedExplorePlace } from '../../../i18n/explore';
import { exploreText } from '../../../i18n/explore-ui';
import { LANGUAGES } from '../../../i18n/utils';

export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) => explorePlaces.map((entry) => ({
    params: { lang, slug: entry.slug }, props: { lang, entry },
  })));
}

const { lang, entry } = Astro.props;
const place = localizedExplorePlace(entry, lang);
const t = (key: Parameters<typeof exploreText>[0]) => exploreText(key, lang);
const placeLabel = (key: 'discover' | 'about' | 'directions') => t(key).replace('{name}', place.name);
const pathFor = (slug: string) => `/${lang}/explore/${slug}/`;
const title = `${place.name} | ${t("guide")}`;
const image = `/explore/${place.slug}.webp`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const map = 'https://www.google.com/maps/search/?api=1&query='
  + encodeURIComponent(`${entry.name}, ${entry.address}`);
const rating = place.rating
  ? `${place.rating.value.toLocaleString(lang === 'pt' ? 'pt-BR' : lang)}/5 · ${place.rating.count.toLocaleString(lang === 'pt' ? 'pt-BR' : lang)} ${t("reviews")}`
  : undefined;
const related = explorePlaces.filter((item) => item.category === place.category && item.slug !== place.slug)
  .slice(0, 3).map((item) => localizedExplorePlace(item, lang));
const date = place.listed && new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  dateStyle: 'medium', timeZone: 'UTC',
}).format(new Date(place.listed));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Cataratas Brasil', item: new URL(`/${lang}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: place.name, item: url },
  ],
};
---
<BaseLayout lang={lang} title={title} description={place.background} image={image}>
  <Nav lang={lang} languageSuffix={`explore/${place.slug}/`} />
  <main>
    <header class="relative min-h-[68vh] flex items-end pt-24 bg-[color:var(--color-ink)] text-white overflow-hidden">
      <img class="absolute inset-0 w-full h-full object-cover" src={image} alt={place.name} fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
      <div class="relative max-w-7xl mx-auto px-6 pb-12 w-full">
        <a class="link-underline" href={`/${lang}/#explore`}>{t('directory')}</a>
        <h1 class="font-display text-4xl md:text-6xl max-w-4xl mt-4">{place.name}</h1>
        <p class="mt-4 max-w-2xl text-lg">{place.tagline}</p>
        {(rating || place.hours) && (
          <ul class="mt-4 flex max-w-2xl flex-wrap gap-x-5 gap-y-2 text-sm text-white/90">
            {rating && <li><a class="link-underline" href="#avaliacoes">{rating}</a></li>}
            {place.hours && <li><a class="link-underline" href="#horarios">{place.hours}</a></li>}
          </ul>
        )}
        <a class="inline-block mt-6 rounded-full bg-[color:var(--color-sun)] text-[color:var(--color-ink)] font-bold px-5 py-3" href={map}>{t('map')} ↗</a>
      </div>
    </header>
    <div class="max-w-4xl mx-auto px-6 py-14 space-y-10 text-[color:var(--color-moss)]">
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{placeLabel('discover')}</h2>
        <p>{place.tagline}{lang === "zh" ? "。" : "."}</p>
        <h3 class="font-display text-xl">{t('tip')}</h3>
        <p>{place.tip}</p>
        <h3 class="font-display text-xl">{t('highlights')}</h3>
        <p>{place.observe}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{placeLabel('about')}</h2>
        <p><strong>{t('management')}</strong> · {place.operator}</p>
        <a class="link-underline" href={place.official}>{t('official')} ↗</a>
      </section>
      <section id="informacoes" class="space-y-4 scroll-mt-20">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('info')}</h2>
        <dl class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-4">
          <div><dt class="font-bold">{t('address')}</dt><dd lang={place.addressLang}>{place.address}</dd></div>
          <div><dt class="font-bold">{t('city')}</dt><dd>{place.city}</dd></div>
          <div><dt class="font-bold">{t('type')}</dt><dd>{t(place.category)}</dd></div>
          <div><dt class="font-bold">{t('operator')}</dt><dd>{place.operator}</dd></div>
          {place.duration && <div><dt class="font-bold">{t('duration')}</dt><dd>{place.duration}</dd></div>}
          {place.parking && <div><dt class="font-bold">{t('parking')}</dt><dd>{place.parking}</dd></div>}
          {rating && <div><dt class="font-bold">{t('rating')}</dt><dd><a href="#avaliacoes" class="link-underline">{rating}</a></dd></div>}
        </dl>
        <p class="text-sm">
          {date && <>{t('record')} {date}. </>}
          <a class="link-underline" href={place.official}>{t('verify')} ↗</a>
        </p>
      </section>
      <section class="space-y-3">
        <h2 id="horarios" class="font-display text-3xl text-[color:var(--color-ink)]">{t('hours')}</h2>
        {place.hours && <p>{place.hours}</p>}
        <a class="link-underline" href={place.official}>{t('hoursLink')} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('tickets')}</h2>
        {place.ticket && <p>{place.ticket}{date && ` · ${t('record')} ${date}`}</p>}
        <a class="link-underline" href={place.official}>{t('ticketLink')} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('arrival')}</h2>
        <p>{place.arrival}</p>
        <a class="link-underline" href={map}>{placeLabel('directions')} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('background')}</h2>
        <p>{place.background}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('walk')}</h2>
        <p>{place.walk}</p>
        <ol class="list-decimal space-y-2 pl-6">
          {place.steps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('notice')}</h2>
        <p>{place.notice}</p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('photo')}</h2>
        <p>{place.photo}</p>
        <p><a class="link-underline text-sm" href={place.photoSource}>{t('photoSource')} ↗</a></p>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('faq')}</h2>
        {[[place.question, place.answer], [place.extraQuestion, place.extraAnswer]].map(([question, answer]) => (
          <details class="rounded-2xl border border-black/10 p-6">
            <summary class="cursor-pointer font-bold">{question}</summary>
            <p class="mt-3">{answer}</p>
          </details>
        ))}
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('stay')}</h2>
        <p>{place.stay}</p>
      </section>
      <section id="avaliacoes" class="rounded-2xl bg-[color:var(--color-mist)] p-6 space-y-3 scroll-mt-20">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{t('visitorReviews')}</h2>
        {rating && <p>
          <strong>{rating}</strong>
          {' '}· {t('reviewsSource')} {date}.
        </p>}
        <a class="link-underline" href={place.mapListing || map}>{t('reviewsLink')} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-3xl text-[color:var(--color-ink)]">{t('mapSection')}</h2>
        <p lang={place.addressLang}>{place.address}</p>
        <a class="link-underline" href={map}>{t('mapLink')} ↗</a>
      </section>
      <section class="space-y-3">
        <h2 class="font-display text-2xl text-[color:var(--color-ink)]">{t('related')}</h2>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {related.map((item) => <li><a class="link-underline" href={pathFor(item.slug)}>{item.name} →</a></li>)}
        </ul>
        <a class="link-underline text-sm" href={place.source}>{t('source')} ↗</a>
      </section>
    </div>
  </main>
  <Footer lang={lang} showAttraction={false} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
