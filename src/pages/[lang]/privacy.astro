---
import '../../../src/styles/global.css';
import { LANGUAGES, type Lang } from '../../i18n/utils';
import { t, privacy, terms } from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const _ = (value: Parameters<typeof t>[0]) => t(value, lang);
---
<BaseLayout lang={lang} title={_(privacy.title)} description={_(privacy.title)} noindex>
  <Nav lang={lang} languageSuffix="privacy/" />
  <main class="travel-legal mx-auto max-w-3xl px-6 pt-24 pb-16">
    <header class="travel-legal-header grain">
      <h1 class="font-display text-4xl md:text-5xl mb-4">{_(privacy.h1)}</h1>
      <p class="text-sm text-white/85">{_(privacy.lastUpdated)}</p>
    </header>

    <section class="space-y-10 text-[color:var(--color-moss)] leading-relaxed">
      <div>
        <h2 class="font-display text-2xl text-[color:var(--color-ink)] mb-3">{_(privacy.h2_collect)}</h2>
        <p>{_(privacy.p_collect)}</p>
      </div>
      <div>
        <h2 class="font-display text-2xl text-[color:var(--color-ink)] mb-3">{_(privacy.h2_use)}</h2>
        <p>{_(privacy.p_use)}</p>
      </div>
      <div>
        <h2 class="font-display text-2xl text-[color:var(--color-ink)] mb-3">{_(privacy.h2_third)}</h2>
        <p>{_(privacy.p_third)}</p>
      </div>
      <div>
        <h2 class="font-display text-2xl text-[color:var(--color-ink)] mb-3">{_(privacy.h2_rights)}</h2>
        <p>{_(privacy.p_rights)}</p>
      </div>
    </section>

    <div class="mt-16 pt-8 border-t border-black/10">
      <a href={`/${lang}/`} class="link-underline text-[color:var(--color-emerald)]">{_(terms.backLink)}</a>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
