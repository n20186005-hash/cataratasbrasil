---
import type { Lang } from '../i18n/utils';
import { highlights } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');

const altMap: Record<Lang, string[]> = {
  zh: [
    '峡谷悬崖漫步 — Mirante da Garganta do Diabo 附近的观景栈道，福斯-杜伊瓜苏，巴西',
    '魔鬼之喉水上栈道洗礼 — Cataratas Brasil 核心水雾栈道观景台',
    '全景电梯 — 连接 Porto Canoas 与下层栈道，俯瞰 Mirante da Garganta do Diabo 全景',
  ],
  en: [
    'Canyon-rim boardwalk near Mirante da Garganta do Diabo, Foz do Iguaçu, Brazil',
    'The mist catwalk at Devil\'s Throat — the core viewpoint of Cataratas Brasil',
    'Panoramic elevator linking Porto Canoas and the lower catwalk overlooking Mirante da Garganta do Diabo',
  ],
  es: [
    'Paseo por el cañón cerca del Mirante da Garganta del Diablo, Foz do Iguaçu, Brasil',
    'La pasarela de niebla de la Garganta del Diablo — el mirante central de Cataratas Brasil',
    'Ascensor panorámico que une Porto Canoas y la pasarela inferior con vistas al Mirante da Garganta del Diablo',
  ],
  pt: [
    'Caminhada no cânion próximo ao Mirante da Garganta do Diabo, Foz do Iguaçu, Brasil',
    'Passarela na névoa da Garganta do Diabo — o mirante central da Cataratas Brasil',
    'Elevador panorâmico ligando Porto Canoas e a passarela inferior com vista para o Mirante da Garganta do Diabo',
  ],
};
---
<section id="highlights" class="bg-[color:var(--color-moss)] text-white py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-14">
      <div><div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-sun)]">02 — {_(highlights.sectionNum)}</div>
      <h2 class="font-display text-4xl md:text-6xl mt-4" set:html={_(highlights.heading)} />
      <p class="mt-3 text-white/55 text-sm md:text-base italic max-w-2xl">
        Highlights & Attractions Around Cataratas Brasil · Mirante da Garganta do Diabo
      </p>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {highlights.items.map((item, i) => (
        <article class={`card-hover rounded-3xl overflow-hidden bg-white/5 border border-white/10 ${i === 1 ? 'md:translate-y-6' : ''}`}>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={item.img}
              alt={altMap[lang][i] || ''}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center hover:scale-105 transition duration-700"
              width="800"
              height="600"
            />
          </div>
          <div class="p-7"><div class="text-[color:var(--color-sun)] text-sm font-medium">{item.icon} {item.num}</div>
          <h3 class="font-display text-2xl mt-2">{_(item.title)}</h3>
          <p class="mt-3 text-white/75 leading-relaxed">{_(item.desc)}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
