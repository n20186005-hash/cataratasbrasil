---
import { placeName } from '../i18n/ui';
import type { Lang } from '../i18n/utils';
import { nearbyCopy, nearbySlugs } from '../i18n/nearby';
import { t, surrounding } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (value: Parameters<typeof t>[0]) => t(value, lang);

const altMap: Record<Lang, string[]> = {
  zh: ['伊瓜苏瀑布全景', '峡谷上方的瀑布水雾', '伊瓜苏瀑布下方的游船'],
  en: ['Panorama of Iguazu Falls', 'Spray rising above the falls gorge', 'Boat below Iguazu Falls'],
  es: ['Panorámica de las cataratas del Iguazú', 'Rocío sobre la garganta de las cataratas', 'Barco bajo las cataratas del Iguazú'],
  pt: ['Panorama das Cataratas do Iguaçu', 'Névoa sobre o cânion das cataratas', 'Barco abaixo das Cataratas do Iguaçu'],
  ko: ['이과수 폭포 전경', '폭포 협곡 위로 피어오르는 물안개', '이과수 폭포 아래의 보트'],
};

const introMap: Record<Lang, string> = {
  zh: '游览 Mirante da Garganta do Diabo 时，游客可轻松探索周边的核心地标与历史景点，包括 Parque das Aves 和 Itaipu Binacional。',
  en: 'When visiting Mirante da Garganta do Diabo, visitors can easily explore surrounding historical landmarks and points of interest, including Parque das Aves and Itaipu Binacional.',
  es: 'Al visitar el Mirante da Garganta del Diablo, los visitantes pueden explorar fácilmente los puntos de interés cercanos, incluidos Parque das Aves e Itaipu Binacional.',
  pt: 'Ao visitar o Mirante da Garganta do Diabo, os visitantes podem explorar facilmente os pontos de interesse ao redor, incluindo o Parque das Aves e a Itaipu Binacional.',
  ko: '이과수 폭포와 함께 새 공원과 이타이푸 수력 발전소를 둘러볼 수 있습니다.',
};
---
<section id="nearby" class="bg-[color:var(--color-mist)] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">08 — {_(surrounding.sectionNum)}</div>
    <h2 class="font-display text-4xl md:text-6xl mt-4 max-w-3xl" set:html={_(surrounding.heading)} />
    <p class="mt-6 max-w-4xl text-[color:var(--color-moss)]/80 text-sm md:text-base italic">
      {introMap[lang]}
    </p>
    <div class="grid md:grid-cols-3 gap-5 mt-14">
      {surrounding.items.map((card, i) => (
        <article class="rounded-3xl bg-white overflow-hidden card-hover">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={card.img}
              alt={altMap[lang][i] || ''}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center hover:scale-105 transition duration-700"
              width="800"
              height="600"
            />
          </div>
          <div class="p-6"><h3 class="font-display text-2xl">{nearbySlugs[i] ? <a class="link-underline" href={`/${lang}/${nearbySlugs[i]}/`}>{card.title.split(" ")[0]} {placeName(nearbySlugs[i], lang)} →</a> : card.title}</h3>
          <p class="mt-2 text-[color:var(--color-moss)] text-sm leading-relaxed">{_(card.desc)}</p></div>
        </article>
      ))}
      {nearbySlugs.slice(surrounding.items.length).map((slug) => (
        <article class="rounded-3xl bg-white overflow-hidden card-hover">
          <img class="aspect-[4/3] w-full object-cover" src={`/nearby/${slug}.webp`} alt={placeName(slug, lang)} loading="lazy" />
          <div class="p-6">
            <h3 class="font-display text-2xl"><a class="link-underline" href={`/${lang}/${slug}/`}>{placeName(slug, lang)} →</a></h3>
            <p class="mt-2 text-[color:var(--color-moss)] text-sm leading-relaxed">{nearbyCopy[slug][lang][0]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
