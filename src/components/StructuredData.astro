---
import type { Lang } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const siteUrl = 'https://cataratasbrasil.com';
const heroImage = `${siteUrl}/gallery/trilha-das-cataratas-brasil%20(6).jpg`;
const mapsShare = 'https://maps.app.goo.gl/jvfSBtLQsZZ4uiaE7';
