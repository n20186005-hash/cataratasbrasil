---
import type { Lang } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const siteUrl = 'https://cataratasbrasil.com';
const heroImage = `${siteUrl}/gallery/trilha-das-cataratas-brasil%20(6).jpg`;
const mapsShare = 'https://maps.app.goo.gl/jvfSBtLQsZZ4uiaE7';
const mapsEmbedSrc = 'https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6394.760838428332!2d-54.4383116!3d-25.6945737!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94f6ea0b10a0b82f%3A0x222948c7f3092ad8!2sMirante%20da%20Garganta%20do%20Diabo!5e1!3m2!1spt-BR!2s!4v1788141182134!5m2!1spt-BR!2s';
const govtTourism = 'https://www.icmbio.gov.br/parnaiguacu';

const descMap: Record<Lang, string> = {
  zh: 'Mirante da Garganta do Diabo 综合游览指南——位于巴西巴拉那州福斯-杜伊瓜苏的伊瓜苏国家公园核心观景台。',
  en: 'Comprehensive visitor guide to Mirante da Garganta do Diabo in Foz do Iguaçu, Paraná, Brazil — the core viewpoint of Iguaçu National Park.',
  es: 'Guía integral del visitante para el Mirante da Garganta del Diablo en Foz do Iguaçu, Paraná, Brasil — el mirador central del Parque Nacional de Iguazú.',
  pt: 'Guia completo do visitante para o Mirante da Garganta do Diabo em Foz do Iguaçu, Paraná, Brasil — o mirante central do Parque Nacional do Iguaçu.',
  ko: '브라질 파라나주 포스두이구아수 이구아수 국립공원의 핵심 전망대, 악마의 목구멍(Mirante da Garganta do Diabo) 종합 방문 가이드.',
};

const tourist = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Place'],
  '@id': `${siteUrl}/#attraction`,
  name: 'Mirante da Garganta do Diabo',
  alternateName: ['Cataratas Brasil', 'Foz do Iguaçu Mirante da Garganta do Diabo', 'Garganta do Diabo Viewpoint', '악마의 목구멍 전망대'],
  description: descMap[lang],
  url: `${siteUrl}/${lang}/`,
  image: [heroImage],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Trilha das Cataratas - Parque Nacional do Iguaçu',
    addressLocality: 'Foz do Iguaçu',
    addressRegion: 'Paraná',
    postalCode: '85855-750',
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -25.6945737,
    longitude: -54.4383116,
  },
  hasMap: mapsShare,
  sameAs: [mapsShare, govtTourism],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '16:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '08:30',
      closes: '16:00',
    },
  ],
});

const webSite = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cataratas Brasil',
  url: siteUrl,
  inLanguage: lang,
});

const webPage = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Mirante da Garganta do Diabo',
  url: `${siteUrl}/${lang}/`,
  inLanguage: lang,
  isPartOf: { '@type': 'WebSite', name: 'Cataratas Brasil', url: siteUrl },
});

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Cataratas Brasil',
      item: `${siteUrl}/${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Mirante da Garganta do Diabo',
      item: `${siteUrl}/${lang}/`,
    },
  ],
});

const faqDataMap: Record<Lang, any> = {
  en: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Where is Mirante da Garganta do Diabo located?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mirante da Garganta do Diabo is located in Foz do Iguaçu, Paraná, Brazil, at the end of the Trilha das Cataratas trail within Iguaçu National Park.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is Cataratas Brasil free to visit?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Mirante da Garganta do Diabo viewpoint is included with the Iguaçu National Park entry ticket. Park admission is charged; however, the viewpoint itself has free access once inside the park.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is the trail physically demanding?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Not at all. About 1.5 km on paved, gently graded paths — friendly to all ages and fully wheelchair accessible.',
        },
      },
      {
        '@type': 'Question',
        name: 'Brazil side vs Argentina side?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Brazil delivers panoramic views of the entire falls system; Argentina puts you inside the cascades via the upper walkway circuit.',
        },
      },
      {
        '@type': 'Question',
        name: "What's the best time to visit?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: '9 AM opening beats the crowds. 2–4 PM offers the best sun angle for rainbows over the Devil\'s Throat.',
        },
      },
    ],
  },
  pt: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Onde fica o Mirante da Garganta do Diabo?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'O Mirante da Garganta do Diabo está localizado em Foz do Iguaçu, Paraná, Brasil, no final da Trilha das Cataratas dentro do Parque Nacional do Iguaçu.',
        },
      },
      {
        '@type': 'Question',
        name: 'O acesso ao mirante é gratuito?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'O Mirante da Garganta do Diabo está incluído no ingresso do Parque Nacional do Iguaçu. A entrada do parque é paga, mas o acesso ao mirante é livre uma vez dentro do parque.',
        },
      },
      {
        '@type': 'Question',
        name: 'A trilha é de esforço físico intenso?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'De forma alguma. São cerca de 1,5 km em caminhos pavimentados com leve declive — acessível a todas as idades e totalmente adaptado para cadeirantes.',
        },
      },
      {
        '@type': 'Question',
        name: 'Lado brasileiro versus lado argentino?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'O Brasil oferece vistas panorâmicas de todo o sistema de quedas; a Argentina coloca você no meio das cascatas pelo circuito superior da passarela.',
        },
      },
      {
        '@type': 'Question',
        name: 'Qual o melhor horário para visitar?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A abertura às 9 h evita a multidão. Das 14 h às 16 h há o melhor ângulo de sol para os arco-íris sobre a Garganta do Diabo.',
        },
      },
    ],
  },
  es: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '¿Dónde está ubicado el Mirante da Garganta del Diablo?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'El Mirante da Garganta del Diablo se encuentra en Foz do Iguaçu, Paraná, Brasil, al final del Sendero de las Cataratas dentro del Parque Nacional de Iguazú.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Es gratuita la visita al mirante?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'El Mirante da Garganta del Diablo está incluido en la entrada al Parque Nacional de Iguazú. La entrada del parque es de pago, pero el acceso al mirante es libre una vez dentro.',
        },
      },
      {
        '@type': 'Question',
        name: '¿El sendero exige esfuerzo físico intenso?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Para nada. Son unos 1,5 km en caminos pavimentados con pendiente suave — accesible a todas las edades y totalmente habilitado para sillas de ruedas.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Lado brasileño o lado argentino?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Brasil ofrece vistas panorámicas de todo el sistema de cascadas; Argentina lo sumerge en medio de las caídas por el circuito superior de la pasarela.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Cuál es el mejor horario para visitar?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'La apertura a las 9 h evita las multitudes. Entre las 14 h y las 16 h hay el mejor ángulo de sol para los arcoíris sobre la Garganta del Diablo.',
        },
      },
    ],
  },
  zh: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Mirante da Garganta do Diabo 在哪里？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mirante da Garganta do Diabo 位于巴西巴拉那州福斯-杜伊瓜苏市，在伊瓜苏国家公园内瀑布步道的终点。',
        },
      },
      {
        '@type': 'Question',
        name: '观景台是免费的吗？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mirante da Garganta do Diabo 观景台包含在伊瓜苏国家公园门票内。园区需购票入园，一旦进入园区，观景台可免费参观。',
        },
      },
      {
        '@type': 'Question',
        name: '步道需要消耗大量体力吗？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '完全不费力。全程约 1.5 公里，路面平整、坡度平缓，适合所有年龄游客，并且全程无障碍通行。',
        },
      },
      {
        '@type': 'Question',
        name: '巴西侧和阿根廷侧有什么区别？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '巴西侧提供整个瀑布群的全景视角；阿根廷侧通过上层栈道将您带到瀑布水流之中。',
        },
      },
      {
        '@type': 'Question',
        name: '最佳游览时间是什么时候？',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '上午 9 点开园时进入可避开人流；下午 2–4 点阳光角度最佳，在魔鬼之喉上方看到彩虹的概率极高。',
        },
      },
    ],
  },
  ko: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '악마의 목구멍 전망대는 어디에 있나요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '악마의 목구멍 전망대(Mirante da Garganta do Diabo)는 브라질 파라나주 포스두이구아수에 위치하며, 이구아수 국립공원 내 트릴랴 다스 카타라타스(Trilha das Cataratas) 산책로 끝에 있습니다.',
        },
      },
      {
        '@type': 'Question',
        name: '전망대 입장은 무료인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '악마의 목구멍 전망대는 이구아수 국립공원 입장권에 포함되어 있습니다. 공원 입장료는 유료이지만, 입장 후 전망대 자체 이용은 무료입니다.',
        },
      },
      {
        '@type': 'Question',
        name: '산책로가 힘든가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '전혀 아닙니다. 포장된 완만한 길 약 1.5km로 모든 연령이 편하게 걸을 수 있으며 휠체어도 완전히 이용 가능합니다.',
        },
      },
      {
        '@type': 'Question',
        name: '브라질 측과 아르헨티나 측의 차이는?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '브라질 측은 폭포 전체 시스템의 파노라마 전망을 제공하고, 아르헨티나 측은 상부 산책로를 통해 폭포 속으로 안내합니다.',
        },
      },
      {
        '@type': 'Question',
        name: '언제 방문하는 것이 가장 좋나요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '오전 9시 개장 때 입장하면 인파를 피할 수 있습니다. 오후 2–4시에는 악마의 목구멍 위로 무지개가 뜰 확률이 가장 높습니다.',
        },
      },
    ],
  },
};

const faqData = JSON.stringify(faqDataMap[lang]);
---
<Fragment set:html={'<script type="application/ld+json">' + tourist + '</script><script type="application/ld+json">' + webSite + '</script><script type="application/ld+json">' + webPage + '</script><script type="application/ld+json">' + breadcrumb + '</script><script type="application/ld+json">' + faqData + '</script>'} />
