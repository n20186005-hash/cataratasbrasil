const govtTourism = 'https://www.icmbio.gov.br/parnaiguacu';

const descMap: Record<Lang, string> = {
  zh: 'Mirante da Garganta do Diabo 综合游览指南——位于巴西巴拉那州福斯-杜伊瓜苏的伊瓜苏国家公园核心观景台。',
  en: 'Comprehensive visitor guide to Mirante da Garganta do Diabo in Foz do Iguaçu, Paraná, Brazil — the core viewpoint of Iguaçu National Park.',
  es: 'Guía integral del visitante para el Mirante da Garganta del Diablo en Foz do Iguaçu, Paraná, Brasil — el mirador central del Parque Nacional de Iguazú.',
  pt: 'Guia completo do visitante para o Mirante da Garganta do Diabo em Foz do Iguaçu, Paraná, Brasil — o mirante central do Parque Nacional do Iguaçu.',
};

const tourist = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: 'Mirante da Garganta do Diabo',
  alternateName: ['Cataratas Brasil', 'Foz do Iguaçu Mirante da Garganta do Diabo', 'Garganta do Diabo Viewpoint'],
  description: descMap[lang],
  url: siteUrl,
  image: [heroImage],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Path Of The Falls Trail - Parque Nacional',
    addressLocality: 'Foz do Iguaçu',
    addressRegion: 'Paraná',
    postalCode: '85855-750',
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -25.6945737,
    longitude: -54.4383116,
  },
  hasMap: mapsShare,
  sameAs: [mapsShare, govtTourism],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '19587',
    bestRating: '5',
    worstRating: '1',
  },
  openingHours: 'Mo-Su 09:00-16:00',
});

const faqDataMap: Record<Lang, any> = {
