---
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="bg-[color:var(--color-ink)] text-[color:var(--color-cream)] py-5 overflow-hidden border-y border-white/10">
  <div class="marquee whitespace-nowrap font-display italic text-xl">
    <span class="flex gap-12"><span>· {ui('viewpoint', lang)}</span><span>· {ui('city', lang)} · {ui('region', lang)} · {ui('country', lang)}</span><span>· 8H56+8Q</span><span>· {ui('park', lang)}</span><span>· UNESCO 1986</span><span>· 275 {ui('falls', lang)}</span><span>· Cataratas Brasil</span></span>
    <span class="flex gap-12" aria-hidden="true"><span>· {ui('viewpoint', lang)}</span><span>· {ui('city', lang)} · {ui('region', lang)} · {ui('country', lang)}</span><span>· 8H56+8Q</span><span>· {ui('park', lang)}</span><span>· UNESCO 1986</span><span>· 275 {ui('falls', lang)}</span><span>· Cataratas Brasil</span></span>
  </div>
</section>
