---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt?: string;
  backHref: string;
  backLabel: string;
  mapHref: string;
  mapLabel: string;
}

const { title, description, image, imageAlt = title, backHref, backLabel, mapHref, mapLabel } = Astro.props;
---
<header class="relative isolate flex min-h-[70svh] items-end overflow-hidden bg-ink pt-28 text-white">
  <img class="absolute inset-0 -z-20 h-full w-full object-cover object-center" src={image} alt={imageAlt} fetchpriority="high" />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink via-ink/65 to-ink/15" aria-hidden="true"></div>
  <div class="rain absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-7xl px-6 pb-12 md:pb-16">
    <a class="chip inline-flex max-w-full rounded-full bg-white/10 px-4 py-2 text-sm text-white hover:bg-white/20" href={backHref}>← {backLabel}</a>
    <h1 class="font-display mt-5 max-w-5xl text-4xl leading-tight font-semibold tracking-tight md:text-6xl lg:text-7xl [overflow-wrap:anywhere]">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 md:text-xl">{description}</p>
    <slot />
    <a class="mt-6 inline-flex rounded-full bg-sun px-6 py-3 font-semibold text-ink hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" href={mapHref}>{mapLabel} ↗</a>
  </div>
</header>
